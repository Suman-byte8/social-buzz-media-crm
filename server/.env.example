# Copy to .env and fill in. Never commit real values.
# Every variable must be set identically on BOTH Render services.

# ── Core ──────────────────────────────────────────────────────────────
NODE_ENV=
PORT=
DATABASE_URL=
JWT_SECRET=
SESSION_SECRET=
CREDENTIALS_ENCRYPTION_KEY=
CORS_ORIGIN=

# ── Google Drive (document storage) ───────────────────────────────────
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# ── Mail ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# ── AI ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Ads integrations: Google Ads ──────────────────────────────────────
# Developer token: Google Ads manager account → Admin → API Center.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth client (Web) from Google Cloud Console, with the Google Ads API enabled.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# Refresh token for scope https://www.googleapis.com/auth/adwords, created
# while signed in as the manager-account admin (consent screen in Production).
GOOGLE_ADS_REFRESH_TOKEN=
# Manager (MCC) account id, digits only.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v23
# Any random string; paste the same value as the "Key" in each Google Ads lead form webhook.
GOOGLE_ADS_LEAD_WEBHOOK_KEY=

# ── Ads integrations: Meta ────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Business Settings → System users → Generate token (never expires) with
# ads_read, business_management, leads_retrieval, pages_show_list,
# pages_read_engagement, pages_manage_metadata, pages_manage_ads.
META_SYSTEM_USER_TOKEN=
META_API_VERSION=v23.0
# Any random string; paste the same value as the Verify Token in the Meta app's webhook settings.
META_WEBHOOK_VERIFY_TOKEN=

# ── Ads integrations: scheduled sync ──────────────────────────────────
# Any long random string; also add it as the ADS_SYNC_SECRET GitHub secret.
ADS_SYNC_SECRET=
